# postgresql

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=askmybook

# minio

MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_NAME=askmybook

# auth (JWT и cookies)

# Секретный ключ для подписи JWT токенов (сгенерируйте свой: openssl rand -hex 32)
SECRET_KEY=my-secret-key
# Алгоритм подписи JWT
ALGORITHM=HS256
# Время жизни access токена в минутах
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Имя cookie для хранения токена
COOKIE_NAME=access_token
# Время жизни cookie в секундах (7 дней)
COOKIE_MAX_AGE=604800
# Отправлять cookie только по HTTPS (true в production)
COOKIE_SECURE=false
# Запретить доступ к cookie из JavaScript (защита от XSS)
COOKIE_HTTPONLY=true
# Политика отправки cookie (lax, strict, none)
COOKIE_SAMESITE=lax
